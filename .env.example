# @BotFather 에서 받은 토큰
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 테이블 생성/불러오기/닫기 권한: 이 텔레그램 ID 만 가능 (여러 명이면 쉼표로). 봇 DM에서 /myid 로 확인
TELEGRAM_CHAT_IDS=

# 선택 설정
TURN_TIMEOUT=60        # 차례당 제한시간(초). 초과 시 자동 체크/폴드
DEFAULT_STACK=30000    # /join 시 시작 칩
DEFAULT_SB=200
DEFAULT_BB=500
REBUY_AMOUNT=30000     # /rebuy 시 추가되는 칩
AWAY_AFTER=2           # 연속 시간 초과 N회 → 자동 자리비움
